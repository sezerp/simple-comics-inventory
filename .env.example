# Required API key for Gemini — used to recognize the cover image (multimodal)
# and search for its metadata (title, publisher, year, description, ISBN) via
# live web search, returned as structured output.
GEMINI_API_KEY=

# Gemini model used for recognition. Defaults to "gemini-2.5-flash".
GEMINI_MODEL=gemini-2.5-flash

# Backend port.
PORT=3001
